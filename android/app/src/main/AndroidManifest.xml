<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- For the cabled meters, on a phone that can host a USB device. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Android 11 and older: scanning needs the location permission. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- Android 12 and later. Scan results are used to find a meter, never a place. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:label="dmm-tools"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".PermissionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android offers the application when one of its cables is
                 plugged in, and a user who takes the offer for good is not
                 asked for the cable again: a permission asked for at run
                 time lasts only until the cable is pulled. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_cables" />
        </activity>

        <!-- configChanges: the native side redraws at the new size itself;
             a recreated activity would start android_main a second time.
             singleTask for the same reason: opening the app from its icon
             while it is in the background comes back to the one there is.
             Full screen: egui is told nothing of the status bar's height on
             Android (egui issue 7748) and would draw its top bar under it. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="dmm_android" />
        </activity>
    </application>
</manifest>
